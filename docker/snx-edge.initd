#!/sbin/openrc-run

name="snx-edge-server"
description="SNX Edge VPN Management Server"

command="/usr/local/bin/snx-edge-server"
command_args="--config /etc/snx-edge/config.toml"
command_background="yes"
# Drop privileges: PID 1 stays as root for OpenRC, but the server process
# itself runs as the unprivileged `snxedge` user. The binary has
# cap_net_admin,cap_net_raw set via setcap so iptables/TUN still work.
# On RouterOS Container (user=0:0), SNX_EDGE_DROP_PRIVS=0 disables this.
if [ "${SNX_EDGE_DROP_PRIVS:-1}" = "1" ]; then
    command_user="snxedge:snxedge"
fi
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/snx-edge/stdout.log"
error_log="/var/log/snx-edge/stderr.log"

depend() {
    need net
    after firewall
}

start_pre() {
    # Auto-create config.toml from example on first boot
    if [ ! -f /etc/snx-edge/config.toml ]; then
        cp /etc/snx-edge/config.toml.example /etc/snx-edge/config.toml
    fi

    # Ensure ip_forward is enabled (root-only sysctl)
    sysctl -w net.ipv4.ip_forward=1 > /dev/null 2>&1

    # Ensure required directories exist and are writable by the snxedge user.
    mkdir -p /var/log/snx-edge /etc/snx-edge/profiles /var/lib/snx-edge
    chown -R snxedge:snxedge /var/log/snx-edge /etc/snx-edge /var/lib/snx-edge

    # Split-DNS: ensure the runtime servers-file dnsmasq reads exists and is
    # writable by snxedge (the server rewrites it from the tunnel ConnectionInfo).
    if [ ! -f /var/lib/snx-edge/corp-servers.conf ]; then
        : > /var/lib/snx-edge/corp-servers.conf
    fi
    chown snxedge:snxedge /var/lib/snx-edge/corp-servers.conf

    # Start the in-container DNS forwarder (target of RouterOS' :53 dst-nat).
    # dnsmasq daemonizes itself; guard with pidof so restarts stay idempotent.
    if ! pidof dnsmasq > /dev/null 2>&1; then
        dnsmasq --conf-file=/etc/dnsmasq.conf
    fi
}
