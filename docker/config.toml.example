# snx-edge-server configuration
#
# Copy this file to /etc/snx-edge/config.toml and customize.
# Secrets are read from environment variables (not stored in this file).

[api]
listen = "0.0.0.0:8080"
# tls_cert = "/etc/snx-edge/tls/server.crt"
# tls_key = "/etc/snx-edge/tls/server.key"
#
# --- mTLS posture: pick AT MOST ONE of the two below ---
#
# tls_client_ca_optional: client certs are verified against this CA *if* the
# client presents one, but a missing cert still completes the TLS handshake.
# JWT remains the only authentication gate. Use this only if you have a
# specific reason to inspect/log client certs without enforcing them.
#
# tls_client_ca_optional = "/etc/snx-edge/tls/ca.crt"
#
# require_client_cert: TLS handshake fails for any client that does not
# present a valid certificate chained to this CA. Provides defence in depth
# on top of JWT — recommended whenever the API is reachable from untrusted
# networks. Note: callers without a cert (e.g. ad-hoc curl health checks)
# will be rejected at the TLS layer; serve `/health` via a separate
# listener if you need an unauthenticated probe path.
#
# require_client_cert = "/etc/snx-edge/tls/ca.crt"
#
# CORS whitelist for browser callers. Empty list (the default) is default-deny.
# cors_origins = ["https://gui.example.com"]

[auth]
jwt_secret_env = "SNX_EDGE_JWT_SECRET"
user_db = "/var/lib/snx-edge/users.db"
max_login_attempts = 5
lockout_duration_minutes = 15
access_token_ttl_minutes = 15
refresh_token_ttl_days = 7

[routeros]
host_env = "ROUTEROS_HOST"
user_env = "ROUTEROS_USER"
password_env = "ROUTEROS_PASSWORD"
tls_skip_verify = false
comment_tag = "managed-by=snx-edge"
# Address lists that drive the split-tunnel policy-based routing. snx-edge only
# reads them; the operator populates them via the API / ctl after `routing setup`.
#   address_list_vpn:    LAN/VPN client SOURCE addresses eligible for PBR.
#   address_list_corp:   corporate DESTINATION subnets that must egress through
#                        the Check Point tunnel. SPLIT-TUNNEL — only traffic to
#                        these dst subnets is marked and routed into the VPN;
#                        all other traffic keeps its normal internet path, and
#                        the kill-switch fails *closed* for these subnets when
#                        the tunnel is down. Populate via POST /api/v1/routing/corp.
#   address_list_bypass: destinations that must NEVER use the tunnel.
address_list_vpn = "vpn-clients"
address_list_corp = "vpn-corp"
address_list_bypass = "vpn-bypass"
routing_table = "vpn-route"
connection_mark = "vpn-conn"
routing_mark = "vpn-route"
auto_setup = false

[logging]
level = "info"
buffer_size = 10000
# file = "/var/log/snx-edge/snx-edge.log"
# max_file_size = "10MB"
# max_files = 3

[security]
# Allow profiles to disable VPN server certificate verification via the
# `no_cert_check` field. Default `false` — profiles attempting to set
# `no_cert_check = true` are rejected at create/update with HTTP 400.
allow_no_cert_check = false
# Serve the management API over plain HTTP on a non-loopback address.
#
# Default `false`, and the server REFUSES TO START in that configuration:
# logins and bearer tokens would cross the LAN in cleartext. It is set to
# `true` here so the quick-start compose file works out of the box on an
# isolated host — for anything reachable by other machines, configure
# api.tls_cert / api.tls_key instead and set this back to false.
allow_plaintext_api = true
# Store VPN profile credentials unencrypted. Default `false`, and the server
# REFUSES TO START without a profile encryption key: the profiles hold your
# gateway password. Set SNX_EDGE_PROFILE_KEY (see docker/.env.example) rather
# than flipping this on.
# allow_plaintext_profiles = false
# CIDRs whose peer_addr is trusted to set X-Forwarded-For / X-Real-IP.
# Empty list (the default) means forwarded headers are never trusted.
# trusted_proxies = ["127.0.0.1/32"]
# Per-IP rate limit on /auth/login and /auth/refresh. After `login_burst`
# requests in quick succession, callers from the same peer IP are throttled
# to `login_rps` requests/sec. Defaults: 1 rps with a burst of 10 — high
# enough not to hit humans retrying typos, low enough to defang automated
# credential-stuffing.
# login_rps = 1
# login_burst = 10
# Enforce the JWT `gen` (token generation) check in require_auth. Default
# `true` — bumping the counter (delete_user, change_password,
# revoke-tokens, revoke-session) invalidates outstanding access tokens
# within at most 30s. Set to `false` for emergency rollback if needed.
# enforce_token_generation = true
# Name of the env var holding a 32-byte ChaCha20-Poly1305 key (base64 or
# hex) used to encrypt VPN profile passwords at rest in `users.db`. When
# unset the server runs in legacy plaintext mode for backwards
# compatibility — existing installs keep working.
# profile_encryption_key_env = "SNX_EDGE_PROFILE_KEY"

[shutdown]
# On graceful shutdown (SIGTERM/SIGINT), run Provisioner::teardown to remove
# the RouterOS PBR rules (kill-switch, mangle, routes, dst-nat, etc.).
# Default `false` — operators usually want the kill-switch preserved across
# container restarts so client traffic stays black-holed instead of leaking
# to the public internet during the maintenance window.
teardown_routeros = false
