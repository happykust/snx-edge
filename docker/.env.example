# Copy this file to docker/.env and edit the values before `docker compose up`.
# docker/.env is gitignored; never commit real secrets.

# JWT signing secret. Must be at least 32 bytes; generate with:
#   openssl rand -base64 32
SNX_EDGE_JWT_SECRET=replace-with-32-byte-random-string

# Bootstrap admin user, created on first start if no users exist.
SNX_EDGE_ADMIN_USER=admin
SNX_EDGE_ADMIN_PASSWORD=replace-with-strong-password

# RouterOS REST API credentials. The user must have write access to the
# routing/firewall trees (see docs for the recommended permission set).
ROUTEROS_HOST=192.168.88.1
ROUTEROS_USER=admin
ROUTEROS_PASSWORD=changeme

# REQUIRED: base64-encoded 32-byte key used to encrypt VPN profile credentials
# at rest. Generate one with:
#
#   openssl rand -base64 32
#
# The server refuses to start while this is blank, because the profiles hold
# your gateway password and would otherwise sit in the SQLite file in
# cleartext. To accept that deliberately, set
# `[security].allow_plaintext_profiles = true` in config.toml instead.
#
# Keep a backup: losing this key makes stored profiles unreadable, and the
# server will refuse to start rather than pretend otherwise.
SNX_EDGE_PROFILE_KEY=

# Optional: drop privileges from root to snxedge user (default: 1).
# Set to 0 when running under RouterOS Container with user=0:0.
SNX_EDGE_DROP_PRIVS=1
