<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>snx-edge third-party licenses</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
    h1 { border-bottom: 1px solid #ccc; padding-bottom: 0.3rem; }
    h2 { margin-top: 2rem; border-bottom: 1px solid #eee; padding-bottom: 0.2rem; }
    pre { background: #f6f8fa; border-radius: 6px; padding: 1rem; overflow-x: auto; font-size: 0.85rem; }
    .crate { margin-bottom: 2rem; }
    .meta { color: #555; font-size: 0.9rem; }
  </style>
</head>
<body>
  <h1>Third-party licenses</h1>
  <p class="meta">
    This document lists the licenses of every Rust crate that is statically
    linked into <code>snx-edge-server</code>. Generated by
    <a href="https://github.com/EmbarkStudios/cargo-about">cargo-about</a>.
  </p>

  <h2>Overview</h2>
  <ul>
  {{#each overview}}
    <li>
      <strong>{{name}}</strong> &mdash; used by {{count}} crate{{#if (gt count 1)}}s{{/if}}
    </li>
  {{/each}}
  </ul>

  <h2>License texts</h2>
  {{#each licenses}}
    <div class="crate">
      <h3>{{name}} ({{id}})</h3>
      <p class="meta">Used by:
        {{#each used_by}}
          <code>{{crate.name}} {{crate.version}}</code>{{#unless @last}}, {{/unless}}
        {{/each}}
      </p>
      <pre>{{text}}</pre>
    </div>
  {{/each}}
</body>
</html>
